{
  "expo": {
    "name": "Virla",
    "slug": "Virla",
    "version": "2.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "virla",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d40d8b3f-ea02-453c-b147-bcc759812005"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.varshaniviral.Virla",
      "buildNumber": "81",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "AppIdentifierPrefix": "C2JVJ4VXRD",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Allow Virla to use your location to find nearby trainers and customize your experience.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Virla to use your location to track travel and display real-time positions during active workouts, even in the background.",
        "NSLocationAlwaysUsageDescription": "Allow Virla to use your location to track travel and display real-time positions during active workouts, even in the background.",
        "NSCameraUsageDescription": "Allow Virla to use your camera to scan QR codes for linking development servers.",
        "NSFaceIDUsageDescription": "Allow Virla to use Face ID to authenticate you securely.",
        "UIBackgroundModes": [
          "location"
        ],
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tez",
          "phonepe",
          "paytmmp",
          "bhim",
          "gpay",
          "upi",
          "credpay"
        ]
      }
    },
    "android": {
      "package": "com.varshaniviral.Virla",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD6t3ORCAH2PtATVajh8fRPL9qso9APVe8"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidUpiAndMaps",
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#4F46E5",
          "sounds": [
            "./assets/sounds/virla_notification.wav",
            "./assets/sounds/virla_reminder.wav",
            "./assets/sounds/virla_booking_alert.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Virla to use your location to track travel and display real-time positions during active workouts, even in the background.",
          "locationAlwaysPermission": "Allow Virla to use your location to track travel and display real-time positions during active workouts, even in the background.",
          "locationWhenInUsePermission": "Allow Virla to use your location to find nearby trainers and customize your experience.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-video",
      [
        "react-native-fbsdk-next",
        {
          "appID": "1152811947398926",
          "clientToken": "b1b3ffd90cbf2359e7e861021e1b9c79",
          "displayName": "VIRLA",
          "scheme": "fb1152811947398926",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Used only to measure which ads led to app installs."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d40d8b3f-ea02-453c-b147-bcc759812005"
      }
    }
